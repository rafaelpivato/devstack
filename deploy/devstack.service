[Unit]
Description=Devstack mobile development controller
After=network.target

[Service]
Type=simple
User=@DEVSTACK_USER@
EnvironmentFile=/etc/devstack/app.env
WorkingDirectory=@DEVSTACK_HOME@
ExecStart=/opt/devstack/current/venv/bin/gunicorn --bind 127.0.0.1:8765 --workers 1 --threads 4 --timeout 30 devstack.web:create_app()
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
