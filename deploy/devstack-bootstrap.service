[Unit]
Description=One-time HTTP onboarding for Devstack Tailscale
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/devstack/bootstrap.env

[Service]
Type=simple
User=devstack
Group=devstack
EnvironmentFile=/etc/devstack/bootstrap.env
ExecStart=/usr/bin/python3 /opt/devstack/current/source/scripts/bootstrap.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
